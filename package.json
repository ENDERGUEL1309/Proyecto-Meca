{
  "name": "proyecto-meca",
  "private": true,
  "version": "0.1.0",
  "description": "Modelador web de terrenos y edificaciones a partir de OpenStreetMap, DEM e imágenes satelitales, con Three.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
